# Copy to .env.local and fill in. Never commit real keys.
#
# The site is a static export (output: 'export'), so there is no server at
# runtime. Only NEXT_PUBLIC_* values exist in the built site; anything else is
# stripped at build time and would silently read as undefined. In CI these are
# set as repository variables -- Settings -> Secrets and variables -> Actions
# -> Variables -- and read by .github/workflows/deploy.yml.

# Site and app
NEXT_PUBLIC_SITE_URL=https://themindx.ai
NEXT_PUBLIC_APP_URL=https://app.themindx.ai

# "true" in preview to highlight [placeholders]; "false" in production
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# "waitlist" (default): CTAs read "Get early access" and open /waitlist;
# /brain-scan and /demo redirect there (the redirects live in public/.htaccess).
# "live": CTAs follow the spec (Brain Scan → app install flow, /demo booking).
# Switching to "live" also means deleting the two waitlist redirects from
# public/.htaccess, or those pages stay unreachable.
NEXT_PUBLIC_LAUNCH_MODE=waitlist

# HubSpot forms. The forms submit straight from the browser to HubSpot's Forms
# Submission API, which needs no token: the portal id and form ids are public
# and appear in HubSpot's own embed snippet. Defaults are compiled in; set
# these only if the ids change.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=247553422
NEXT_PUBLIC_HUBSPOT_FORMS_API_BASE=https://api-na2.hsforms.com
NEXT_PUBLIC_HUBSPOT_FORM_WAITLIST=b5253b45-b45f-404d-90d8-03be9814a641
NEXT_PUBLIC_HUBSPOT_FORM_DESIGN_PARTNER=d8213d15-0e98-404b-bf7a-fa849776a857
NEXT_PUBLIC_HUBSPOT_FORM_NEWSLETTER=653bee33-0663-4e15-a44c-b66914851985

# There is no HubSpot form for integration requests yet. Until one exists and
# this points at it, those submissions go to the newsletter form and the
# requested tool is dropped -- that form has no field to hold it.
NEXT_PUBLIC_HUBSPOT_FORM_INTEGRATION=

# Bot protection. The Turnstile widget still renders, but nothing verifies its
# token any more: verification needs TURNSTILE_SECRET_KEY on a server, and
# there isn't one. Turn on HubSpot's own bot protection in each form's settings
# instead -- that runs on HubSpot's side and is what actually stops junk
# submissions now.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (Phase 7)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Booking (used when NEXT_PUBLIC_LAUNCH_MODE=live)
NEXT_PUBLIC_CAL_LINK=

# ---------------------------------------------------------------------------
# Removed with the API routes (see git history for app/api and lib/server):
#   HUBSPOT_FORMS_ENABLED, HUBSPOT_PRIVATE_APP_TOKEN, SLACK_LEADS_WEBHOOK_URL,
#   HUBSPOT_DESIGN_PARTNER_PIPELINE_ID, HUBSPOT_DESIGN_PARTNER_STAGE_ID,
#   LEAD_SIGNING_SECRET, TURNSTILE_SECRET_KEY
# They need a server. Restore them if the site ever moves back to Node hosting.
