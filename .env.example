# Copy to .env.local and fill in. Never commit real keys.

# Site and app
NEXT_PUBLIC_SITE_URL=https://themindx.ai
NEXT_PUBLIC_APP_URL=https://app.themindx.ai

# "true" in preview to highlight [placeholders]; "false" in production
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# "waitlist" (default): CTAs read "Get early access" and open /waitlist;
# /brain-scan and /demo redirect there.
# "live": CTAs follow the spec (Brain Scan → app install flow, /demo booking).
NEXT_PUBLIC_LAUNCH_MODE=waitlist

# HubSpot forms (option B): our forms submit to these HubSpot forms through the
# Forms API. No token needed. Defaults are built in; override only if they change.
# HUBSPOT_FORMS_ENABLED: on in production, off in development (so local tests
# don't create contacts). Set "true" to send from your machine, "false" to stop.
HUBSPOT_FORMS_ENABLED=
HUBSPOT_PORTAL_ID=247553422
HUBSPOT_FORMS_API_BASE=https://api-na2.hsforms.com
HUBSPOT_FORM_WAITLIST=b5253b45-b45f-404d-90d8-03be9814a641
HUBSPOT_FORM_DESIGN_PARTNER=d8213d15-0e98-404b-bf7a-fa849776a857
HUBSPOT_FORM_NEWSLETTER=653bee33-0663-4e15-a44c-b66914851985

# Optional extras. The private-app token adds properties the forms don't carry
# (utm, lead type) and design-partner deals; Slack posts an alert to #leads.
# With neither set: development prints leads to the server log (not saved);
# production refuses signups so none are silently lost.
HUBSPOT_PRIVATE_APP_TOKEN=
SLACK_LEADS_WEBHOOK_URL=
# Optional: create a HubSpot deal for each design-partner application.
HUBSPOT_DESIGN_PARTNER_PIPELINE_ID=
HUBSPOT_DESIGN_PARTNER_STAGE_ID=
# Recommended: a long random string that signs the step-2 token.
# Falls back to the HubSpot token, then the Slack webhook URL.
LEAD_SIGNING_SECRET=

# Bot protection (Cloudflare Turnstile). The site key must be public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (Phase 7)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Booking (used when NEXT_PUBLIC_LAUNCH_MODE=live)
NEXT_PUBLIC_CAL_LINK=
